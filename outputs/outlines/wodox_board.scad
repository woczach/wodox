module board_2d() {
    // grown outward by PCB_CLEARANCE so the real board drops into the print
    offset(delta = PCB_CLEARANCE) polygon(points=outer);
}

// Stepped switch holes: 14.7 from z0..LIP_Z0, 14.0 from LIP_Z0..LIP_Z1,
// then 14.7 again from LIP_Z1 up through the top.
// Each square is centered (center=true) on the switch centre s=[x,y,rot] from
// the PCB (footprint origin = the Choc centre peg at local (0,0)), then rotated
// to the switch's ergo angle.
module switch_cutouts_3d(t=BOARD_THICKNESS) {
    for (s=switches)
        translate([s[0], s[1], 0]) rotate([0, 0, s[2]]) {
            linear_extrude(height=LIP_Z0)
                square([CHOC_OUTER, CHOC_OUTER], center=true);
            translate([0, 0, LIP_Z0])
                linear_extrude(height=LIP_Z1-LIP_Z0)
                    square([CHOC_LIP, CHOC_LIP], center=true);
            translate([0, 0, LIP_Z1])
                linear_extrude(height=t-LIP_Z1)
                    square([CHOC_OUTER, CHOC_OUTER], center=true);
        }
}

module board_3d(with_cutouts=WANT_CUTOUTS, t=BOARD_THICKNESS) {
    difference() {
        linear_extrude(height=t) board_2d();
        if (with_cutouts) switch_cutouts_3d(t=t);
    }
}

// --- Component 2D profiles (used as through-cutouts) ---
module rp2040_body_2d() {       // rounded rect 18 x 23.5, r=1
    translate([RP2040_POS[0], RP2040_POS[1]])
      rotate([0,0,RP2040_ROT]) mirror([0,1,0])
        offset(r=1) square([16, 21.5], center=true);
}

module rp2040_usb_2d() {        // USB rect 7.1 x 5.08
    translate([RP2040_POS[0], RP2040_POS[1]])
      rotate([0,0,RP2040_ROT]) mirror([0,1,0])
        translate([0,-10.91]) square([7.1, 30.08], center=true);
}

module pj320e_2d() {            // 3.5mm jack slot: same start, lengthened outward
    // starts at the jack body (local y=2.1) and extends past the outline wall
    translate([PJ320E_POS[0], PJ320E_POS[1]])
      rotate([0,0,PJ320E_ROT]) mirror([0,1,0])
        translate([2.75, -8.45]) square([7.3, 21.1], center=true);  // y: 2.1 .. -19
}

// RP2040 + USB + jack punched through the full stack (bottom plate -> top plate)
module component_cutouts() {
    translate([0, 0, -PLATE_GAP - PLATE_THICKNESS])
      linear_extrude(height = BOARD_THICKNESS + PLATE_GAP + PLATE_THICKNESS + 2) {
          rp2040_body_2d();
          rp2040_usb_2d();
          pj320e_2d();
      }
}

// bottom plate: board outline only, solid (no switch cutouts),
// sitting PLATE_GAP below the top plate
module bottom_plate(t=PLATE_THICKNESS, gap=PLATE_GAP) {
    translate([0, 0, -gap - t]) linear_extrude(height=t) board_2d();
}

// outline wall: OUTLINE-wide ring around the board shape, h tall, based at z0
module plate_outline(h, z0) {
    difference() {
        translate([0, 0, z0])
            linear_extrude(height=h) offset(delta=OUTLINE) board_2d();
        translate([0, 0, z0 - 1])
            linear_extrude(height=h + 2) board_2d();
    }
}

// M3 screw clearance holes through the top outline
module top_screw_holes() {
    for (s=screws)
        translate([s[0], s[1], -1])
            cylinder(d=M3_CLEAR_D, h=BOARD_THICKNESS+2, $fn=48);
}

// M3 heat-set insert holes in the bottom outline (blind, from its top face)
module bottom_insert_holes() {
    ztop = -PLATE_GAP - PLATE_THICKNESS + BOT_OUTLINE_H;   // top of bottom outline
    for (s=screws)
        translate([s[0], s[1], ztop - M3_INSERT_H])
            cylinder(d=M3_INSERT_D, h=M3_INSERT_H+1, $fn=48);
}

// Local barrels around each screw so the thin outline has enough material
// for the insert (bottom) and clearance (top) holes.
module screw_bosses_top() {
    d = M3_INSERT_D + 2*SCREW_BOSS_WALL;
    for (s=screws)
        translate([s[0], s[1], 0])
            cylinder(d=d, h=TOP_OUTLINE_H, $fn=48);
}
module screw_bosses_bottom() {
    d = M3_INSERT_D + 2*SCREW_BOSS_WALL;
    for (s=screws)
        translate([s[0], s[1], -PLATE_GAP - PLATE_THICKNESS])
            cylinder(d=d, h=BOT_OUTLINE_H, $fn=48);
}

// TOP printable part: switch plate + top outline + screw clearance holes
module top_part() {
    difference() {
        union() {
            board_3d();
            plate_outline(TOP_OUTLINE_H, 0);
            screw_bosses_top();
        }
        component_cutouts();
        top_screw_holes();
    }
}

// BOTTOM printable part: bottom plate + bottom outline + insert holes
module bottom_part() {
    difference() {
        union() {
            bottom_plate();
            plate_outline(BOT_OUTLINE_H, -PLATE_GAP - PLATE_THICKNESS);
            screw_bosses_bottom();
        }
        component_cutouts();
        bottom_insert_holes();
    }
}

// one complete half (both printable parts)
module board_half() {
    union() {
        top_part();
        bottom_part();
    }
}

function _max_x(p, i=0, m=-1e9) =
    i >= len(p) ? m : _max_x(p, i+1, max(m, p[i][0]));

BOARD_W = _max_x(outer);        // width of one half (board starts at x=0)

// ---- Export selector -------------------------------------------------------
// Render a single printable part: openscad -D 'PART="top"' -D 'SIDE="left"' ...
PART = "all";    // "all" | "top" | "bottom"
SIDE = "both";   // "both" | "left" | "right"

module selected() {
    if (SIDE == "left" || SIDE == "both") {
        if (PART == "top"    || PART == "all") top_part();
        if (PART == "bottom" || PART == "all") bottom_part();
    }
    if (SIDE == "right" || SIDE == "both") {
        translate([2*BOARD_W + SPLIT_GAP, 0, 0]) mirror([1,0,0]) {
            if (PART == "top"    || PART == "all") top_part();
            if (PART == "bottom" || PART == "all") bottom_part();
        }
    }
}
selected();

